# --- Этап 1: Сборка (Builder) ---
# Этот этап отвечает за сборку статических ассетов фронтенд-приложения.
# Используем образ 'slim' на основе Debian для надежной совместимости
# с нативными зависимостями, которые могут потребоваться при сборке.
FROM node:24-slim AS builder

# Устанавливаем рабочую директорию внутри контейнера для всех последующих команд.
WORKDIR /app

# Копируем файлы package.json и package-lock.json.
# Этот шаг вынесен наверх для использования кэширования слоев Docker:
# зависимости будут переустанавливаться только при изменении этих файлов.
COPY package*.json ./
# Явно копируем lock-файл для pnpm.
COPY pnpm-lock.yaml ./

# Включаем Corepack, стандартный инструмент Node.js для управления версиями
# пакетных менеджеров.
RUN corepack enable

# Устанавливаем зависимости с помощью pnpm.
# Флаг --frozen-lockfile гарантирует детерминированную сборку.
RUN pnpm install --frozen-lockfile

# Копируем все остальные файлы исходного кода в рабочую директорию.
COPY . .

# Собираем production-версию приложения.
# Результат сборки (статические файлы) будет помещен в директорию /app/dist.
RUN npm run build


# --- Этап 2: Финальный образ-артефакт ---
# Этот минималистичный этап служит "контейнером" для собранных файлов.
# Его единственная задача - предоставить артефакты сборки (папку /app/dist)
# для монтирования в именованный volume через Docker Compose.
FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/dist .